{
  "name": "africa-live",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "start:local": "next start --hostname 127.0.0.1 --port 3001",
    "config:check": "tsx src/scripts/check-environment.ts",
    "config:check:production": "tsx src/scripts/check-environment.ts --production",
    "config:check:staging": "tsx src/scripts/check-environment.ts --staging",
    "lint": "eslint",
    "test": "tsx --test src/lib/*.test.ts",
    "test:integration": "tsx src/scripts/test-integration.ts",
    "test:invariants": "tsx --test src/lib/control-plane-invariants.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "baseline:db": "tsx src/scripts/export-db-inventory.ts",
    "backup:restore-drill:local": "tsx src/scripts/test-backup-restore.ts",
    "backup:restore-drill:railway": "tsx src/scripts/backup-restore-railway.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "tsx src/scripts/migrate-deploy.ts",
    "db:check": "tsx src/scripts/check-schema-drift.ts",
    "db:check:migrations": "drizzle-kit check",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "import:m3u": "tsx src/scripts/import-m3u.ts",
    "backfill:languages": "tsx src/scripts/backfill-channel-languages.ts",
    "migrate:postgres": "tsx src/scripts/migrate-sqlite-to-postgres.ts",
    "report:playback": "tsx src/scripts/report-playback.ts",
    "report:eligibility": "tsx src/scripts/report-direct-eligibility.ts",
    "inventory:media": "tsx src/scripts/inventory-secure-media.ts",
    "poc:media": "tsx src/scripts/poc-secure-media-transport.ts",
    "capacity:media": "tsx src/scripts/estimate-media-capacity.ts",
    "telemetry:retention": "tsx src/scripts/retain-playback-telemetry.ts",
    "abuse:cleanup": "tsx src/scripts/cleanup-abuse-counters.ts",
    "verify:streams": "tsx src/scripts/verify-streams.ts",
    "diagnose:local": "tsx src/scripts/diagnose-local.ts",
    "setup:local": "tsx src/scripts/setup-local.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.5.7",
    "@next/env": "16.3.5",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "hls.js": "^1.6.16",
    "iptv-playlist-parser": "^0.15.2",
    "lucide-react": "^1.21.0",
    "next": "16.3.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.20.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
